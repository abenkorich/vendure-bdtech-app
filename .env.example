# Copy to `.env`. EXPO_PUBLIC_* values are inlined into the JS bundle at build
# time, so they are visible to anyone who unpacks the app. Never put a secret
# behind that prefix.

# Vendure Shop API. The production catalogue is a good dev target.
EXPO_PUBLIC_VENDURE_SHOP_API_URL=https://api.dzduino.dz/shop-api
# The channel token, NOT the literal "__default_channel__" string: the backend
# rejects that. Copy the value from the storefront's .env, or read it from
# `{ activeChannel { token } }`.
EXPO_PUBLIC_VENDURE_CHANNEL_TOKEN=

# Canonical site origin, used to build shareable product/collection links.
EXPO_PUBLIC_SITE_URL=https://dzduino.dz
