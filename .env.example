# Copy to `.env`. EXPO_PUBLIC_* values are inlined into the JS bundle at build
# time, so they are visible to anyone who unpacks the app. Never put a secret
# behind that prefix.

# Vendure Shop API. The production catalogue is a good dev target.
EXPO_PUBLIC_VENDURE_SHOP_API_URL=https://api.dzduino.dz/shop-api
# The channel token, NOT the literal "__default_channel__" string: the backend
# rejects that. Copy the value from the storefront's .env, or read it from
# `{ activeChannel { token } }`.
EXPO_PUBLIC_VENDURE_CHANNEL_TOKEN=

# Canonical site origin: site config, customizer images and shareable links.
# Must be the `www` host. The bare `dzduino.dz` serves Traefik's default
# self-signed certificate, so every request to it fails TLS verification.
EXPO_PUBLIC_SITE_URL=https://www.dzduino.dz

# Google sign-in. The client id the *backend* verifies against is configured
# in Vendure and read at runtime, so it is not here. These two are the
# platform OAuth clients from the Google console, in the same project:
#
#   iOS      bundle id dz.dzduino.app. Read by the app: it becomes the URL
#            scheme Google redirects back through, so it must be set before
#            an iOS build or the button will not appear.
#   Android  package dz.dzduino.app plus the signing SHA-1. Registered in the
#            console only — the library matches the app by signature, so this
#            value is never read. Kept here as a record of what was created.
#
# Neither is a secret: Google issues no client secret for mobile clients, and
# both are recoverable from any installed build.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
